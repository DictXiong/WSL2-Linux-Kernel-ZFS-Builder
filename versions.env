# WSL kernel source. WSL_COMMIT must be the commit currently resolved by WSL_REF.
WSL_REPOSITORY=https://github.com/microsoft/WSL2-Linux-Kernel.git
WSL_REF=linux-msft-wsl-6.18.y
WSL_COMMIT=14794180686c2fb6307fbe359c359bec765249f3

# OpenZFS source. Pin both the release tag and its peeled commit.
ZFS_REPOSITORY=https://github.com/openzfs/zfs.git
ZFS_REF=zfs-2.4.3
ZFS_COMMIT=83020cf8259d057d4cc9102010c05f07ffdfc136

# Appended to CONFIG_LOCALVERSION after the ZFS release tag.
BUILD_SUFFIX=dxng
